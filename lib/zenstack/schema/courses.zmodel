import "./auth"

model Course {
  id          String        @id @default(cuid())
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  title       String
  slug        String        @unique
  description String?
  coverImage  String?
  price       Float         // in cents for Stripe (denormalized current price)
  published   Boolean       @default(false)
  lessons     Lesson[]
  prices      CoursePrice[]
  purchases   Purchase[]
  events      CourseEvent[]

  @@map('course')

  // Anyone can read published courses
  @@allow('read', published == true)
  // Admins can do everything
  @@allow('all', auth() != null && auth().role == 'admin')
}

model CoursePrice {
  id        String     @id @default(cuid())
  createdAt DateTime   @default(now())
  courseId  String
  course    Course     @relation(fields: [courseId], references: [id], onDelete: Cascade)
  price     Float     // price in cents
  validFrom DateTime   @default(now())
  validTo   DateTime? // null means current/active price
  purchases Purchase[]

  @@map('course_price')

  // Same access as Course - anyone can read prices for published courses
  @@allow('read', course.published == true)
  // Admins can do everything
  @@allow('all', auth() != null && auth().role == 'admin')
}

model Lesson {
  id          String           @id @default(cuid())
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  title       String
  description String?
  videoUrl    String?          // placeholder for video hosting
  content     String?          // rich text/markdown content
  order       Int              @default(0)
  courseId    String
  course      Course           @relation(fields: [courseId], references: [id], onDelete: Cascade)
  progress    LessonProgress[]

  @@map('lesson')

  // Purchased users or admins can read lessons
  @@allow('read', auth() != null && (auth().role == 'admin' || course.purchases?[userId == auth().userId]))
  // Admins can do everything
  @@allow('all', auth() != null && auth().role == 'admin')
}

model Purchase {
  id              String         @id @default(cuid())
  createdAt       DateTime       @default(now())
  userId          String
  user            User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  courseId        String
  course          Course         @relation(fields: [courseId], references: [id], onDelete: Cascade)
  coursePriceId   String
  coursePrice     CoursePrice    @relation(fields: [coursePriceId], references: [id])
  stripePaymentId String?
  amount          Float          // actual amount paid via Stripe
  refundedAt      DateTime?
  refundRequest   RefundRequest?

  @@unique([userId, courseId])
  @@map('purchase')

  // Users can read their own purchases
  @@allow('read', auth() != null && auth().userId == userId)
  // Admins can read all purchases
  @@allow('read', auth() != null && auth().role == 'admin')
  // System creates purchases (via webhook), admins can manage
  @@allow('create,update,delete', auth() != null && auth().role == 'admin')
}

model LessonProgress {
  id          String    @id @default(cuid())
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  lessonId    String
  lesson      Lesson    @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  completed   Boolean   @default(false)
  completedAt DateTime?

  @@unique([userId, lessonId])
  @@map('lesson_progress')

  // Users can manage their own progress
  @@allow('all', auth() != null && auth().userId == userId)
  // Admins can read all
  @@allow('read', auth() != null && auth().role == 'admin')
}

model CourseEvent {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  courseId  String
  course    Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  type      String   // 'started' | 'completed'
  emailSent Boolean  @default(false)

  @@map('course_event')

  // Users can create their own events
  @@allow('create', auth() != null && auth().userId == userId)
  // Users can read their own, admins can read all
  @@allow('read', auth() != null && (auth().userId == userId || auth().role == 'admin'))
  // Admins can update (e.g., mark emailSent)
  @@allow('update', auth() != null && auth().role == 'admin')
}

model RefundRequest {
  id          String    @id @default(cuid())
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  purchaseId  String    @unique
  purchase    Purchase  @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  reason      String    // e.g., "not_as_described", "changed_mind", "technical_issues", "other"
  note        String?   // customer's explanation
  status      String    @default("pending") // pending | approved | rejected | cancelled
  adminNote   String?   // admin's response note
  processedAt DateTime?
  processedBy String?   // admin user id

  @@map('refund_request')

  // Users can read their own refund requests
  @@allow('read', auth() != null && purchase.userId == auth().userId)
  // Users can create refund requests for their own purchases
  @@allow('create', auth() != null && purchase.userId == auth().userId)
  // Users can cancel their own pending requests
  @@allow('update', auth() != null && purchase.userId == auth().userId && status == 'pending')
  // Admins can read and update all
  @@allow('read,update', auth() != null && auth().role == 'admin')
}

